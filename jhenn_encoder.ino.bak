#include <Arduino_FreeRTOS.h>
#include <semphr.h> //para la inclusion de semaforos con FreeRTOS
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

//=====================================================
//DEFINICIONES
//****************************************************
//PINES
//Para el sensor de Efecto Hall
#define PULSO_HALL 2

//****************************************************
//CONSTANTES
#define NUM_PI 3.141592f
#define NUM_IMANES 4
#define CANT_MUESTRAS 10 //cantidad de muestras
#define PERIODO_ACTUALIZAR_RPM 700 //[ms]


//=====================================================
//VARIABLES GLOBALES
unsigned long tiempoEntreImanes;
unsigned long tiempoImanAnterior = 0;
volatile long muestras[CANT_MUESTRAS] = {0};
volatile int contadorPulsos = 0; //para las actualizaciones en el LCD
volatile float RPM;


//Simbolos personalizados para la pantalla LCD
byte simboloPlay[8] = {0x1F, 0x17, 0x13, 0x11, 0x13, 0x17, 0x1F, 0x00};
byte simboloPausa[8] = {0x1F, 0x15, 0x15, 0x15, 0x15, 0x15, 0x1F, 0x00};
byte simboloParo[8] = {0x1F, 0x1F, 0x11, 0x11, 0x11, 0x1F, 0x1F, 0x00};
byte simboloFlecha[8] = {0x08, 0x0C, 0x0E, 0x0F, 0x0E, 0x0C, 0x08, 0x00};
//Objeto para el display LCD
LiquidCrystal_I2C lcd(0x27, 16, 2);

//=====================================================
//PROTOTIPO DE LAS FUNCIONES
void notificarPulso();



//=====================================================
//FREERTOS

//****************************************************
//Handle de los Semaforos
SemaphoreHandle_t PulsoHallSemaphoreBin = NULL; //semaforo binario
SemaphoreHandle_t ArregloMuestrasMutex = NULL;
SemaphoreHandle_t ContadorPulsosMutex = NULL;
SemaphoreHandle_t ValoresRPMMutex = NULL;

//****************************************************
//Handle de las Tareas
TaskHandle_t ProcesarPulsosHallTaskHandle = NULL;
TaskHandle_t ProcesamientoMuestrasTaskHandle = NULL;
TaskHandle_t ActualizarVelocidadTaskHandle = NULL;


//****************************************************
//Funciones de las Tareas
//Tarea 1. Procesamiento de los pulsos enviados desde la funcion de interrupcion
void ProcesarPulsosHallTask(void *parameter){
	int contador = 0;

	for (;;){
		//esperar el semaforo binario hasta el infito
		if (xSemaphoreTake(PulsoHallSemaphoreBin, portMAX_DELAY) == pdTRUE){
			unsigned long tiempoActual = millis();

			//guardar muestras en el arreglo
			if (contador < CANT_MUESTRAS){
				tiempoEntreImanes = tiempoActual - tiempoImanAnterior;
				Serial.println("\vPulso detectado");
				Serial.print("El tiempo entre imanes: ");
				Serial.println(tiempoEntreImanes);
				
				Serial.print("Contador: ");
				Serial.println(contador);

				if (xSemaphoreTake(ArregloMuestrasMutex, pdMS_TO_TICKS(150)) == pdTRUE){
					muestras[contador] = (long) tiempoEntreImanes;
					
					xSemaphoreGive(ArregloMuestrasMutex);
				}

				tiempoImanAnterior = tiempoActual;
				contador++;
			}
			else { //notificar a la tarea de procesamiento y reiniciar el contador
				xTaskNotifyGive(ProcesamientoMuestrasTaskHandle);
				contador = 0;
			}

			//para el contador de pulsos y la actualizacion en tiempo real
			if (xSemaphoreTake(ContadorPulsosMutex, pdMS_TO_TICKS(200)) == pdTRUE){
				contadorPulsos++;

				xSemaphoreGive(ContadorPulsosMutex);
			}
		}

		vTaskDelay(5 / portTICK_PERIOD_MS);
	}
}

//Tarea 2. Procesamiento de las muestras
void ProcesamientoMuestrasTask(void *parameter){
	for (;;){
		ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
		long muestras_local[CANT_MUESTRAS] = {0};
		float suma = 0.0f, promedio_tiempo;
		float angulo_entre_imanes, rpm;

		if (xSemaphoreTake(ArregloMuestrasMutex, pdMS_TO_TICKS(150)) == pdTRUE){
			for (int i = 0; i < CANT_MUESTRAS; i++) muestras_local[i] = muestras[i];

			xSemaphoreGive(ArregloMuestrasMutex);
		}

		//procesamiento de las muestras (copia locales)
		for (int i = 0; i < CANT_MUESTRAS; i++) suma += (float) muestras_local[i];
		promedio_tiempo = (suma / (float) CANT_MUESTRAS) / 1000.0f; //tiempo en [s]
	
		//calculando el angulo entre imanes
		angulo_entre_imanes = (2.0f * NUM_PI) / (float) NUM_IMANES; //[radianes]
		//calculando los RPM
		rpm = (30.0f * angulo_entre_imanes) / (NUM_PI * promedio_tiempo);

		if (xSemaphoreTake(ValoresRPMMutex, pdMS_TO_TICKS(100)) == pdTRUE){
			RPM = rpm;

			xSemaphoreGive(ValoresRPMMutex);
		}	

		vTaskDelay(5 / portTICK_PERIOD_MS);
	}
}

//Tarea 3. Actualizar de velocidad en tiempo real
void ActualizarVelocidadTask(void *parameter){
	TickType_t xLastWakeTime = xTaskGetTickCount();
	const TickType_t periodoActualizarRPM = pdMS_TO_TICKS(PERIODO_ACTUALIZAR_RPM);

	for (;;){
		int contadorPulsosLocal;
		float rpmLocal = 0.0f;

		if (xSemaphoreTake(ContadorPulsosMutex, pdMS_TO_TICKS(200)) == pdTRUE){
			contadorPulsosLocal = contadorPulsos;
			contadorPulsos = 0;

			xSemaphoreGive(ContadorPulsosMutex);
		}
		
		if (contadorPulsosLocal != 0){
			if (xSemaphoreTake(ValoresRPMMutex, pdMS_TO_TICKS(100)) == pdTRUE){
				rpmLocal = RPM;

				xSemaphoreGive(ValoresRPMMutex);
			}	
			
			Serial.print("RPM: ");
			Serial.println(rpmLocal);
			lcd.setCursor(0, 1);
			lcd.print(rpmLocal);
		}

		vTaskDelayUntil(&xLastWakeTime, periodoActualizarRPM);
	}
}


//=====================================================
void setup() {
	Serial.begin(115200);

	//****************************************************
	//CONFIGURACION PARA LOS PINES
	//Para el sensor de Efecto Hall
	pinMode(PULSO_HALL, INPUT); //pull down

	//Para el LCD
	lcd.init();
	lcd.backlight();
	lcd.createChar(0, simboloPlay);
	lcd.createChar(1, simboloPausa);
	lcd.createChar(2, simboloParo);
	lcd.createChar(3, simboloFlecha);
	lcd.setCursor(0, 0);
	lcd.print("BIENVENIDO");

	//****************************************************
	//FREERTOS: Creacion de los semaforos
	PulsoHallSemaphoreBin = xSemaphoreCreateBinary();
	ArregloMuestrasMutex = xSemaphoreCreateMutex();
	ContadorPulsosMutex = xSemaphoreCreateMutex();
	ValoresRPMMutex = xSemaphoreCreateMutex();

	//****************************************************
	//CONFIGURACION LAS INTERRUPCIONES
	attachInterrupt(digitalPinToInterrupt(PULSO_HALL), notificarPulso, RISING);

	//****************************************************
	//FREERTOS: Creacion de las tareas
	//Tarea 1. Procesamiento de los pulsos enviados desde la funcion de interrupcion
	xTaskCreate(
		ProcesarPulsosHallTask, //la funcion de la tarea
		"ProcesarPulsosHallTask",  //el nombre de la tarea
		256, //memoria en la pila
		NULL,
		2, //prioridad
		&ProcesarPulsosHallTaskHandle //el handle de la tarea
	);

	//Tarea 2. Procesamiento de las muestras
	xTaskCreate(
		ProcesamientoMuestrasTask, //la funcion de la tarea
		"ProcesamientoMuestrasTask",  //el nombre de la tarea
		256, //memoria en la pila
		NULL,
		1, //prioridad
		&ProcesamientoMuestrasTaskHandle//el handle de la tarea
	);

	//Tarea 3. Actualizar de velocidad en tiempo real
	xTaskCreate(
		ActualizarVelocidadTask, //la funcion de la tarea
		"ActualizarVelocidadTask",  //el nombre de la tarea
		256, //memoria en la pila
		NULL,
		1, //prioridad
		&ActualizarVelocidadTaskHandle//el handle de la tarea
	);

}

//=====================================================
void loop() {
}

//=====================================================
//FUNCIONES
//Funcion Callback para la interrupcion del sensor de Efecto Hall
void notificarPulso(){
	BaseType_t xHigherPriorityTaskWoken = pdFALSE;

	//enviando una segnal mediante el semaforo binario
	xSemaphoreGiveFromISR(PulsoHallSemaphoreBin, &xHigherPriorityTaskWoken);

	//solicitando cambio de contexto (opcional)
	if (xHigherPriorityTaskWoken){
		portYIELD_FROM_ISR();
	}
}


